---
import { SITE } from '../data/site';
import Corners from './Corners.astro';
interface Props { heading?: string; text?: string }
const {
  heading = 'まずは無料の範囲で、1つだけ聞いてみる',
  text = '恋愛や相性の相談が得意な占い師を選んで、気になっていることを1つ聞いてみましょう。',
} = Astro.props;
const url = SITE.affiliate.coconalaUrl;
const pixel = SITE.affiliate.coconalaPixel;
---
<div class="cta frame reveal">
  <Corners />
  <span class="pr">PR</span>
  <h3 set:html={heading} />
  <p>{text}</p>
  <div class="cta-free">
    <span class="cta-free-lead">ココナラ電話占いは、はじめての方なら</span>
    <span class="cta-free-main"><small>最大</small><b>30</b><small>分</small><em>無料</em></span>
    <span class="cta-free-cond">※専用ページから新規登録するともらえる3,000円分のクーポンを使った場合。1分100円の占い師なら最大30分、料金の高い占い師ではそれより短くなります。</span>
  </div>
  <ul class="cta-points">
    <li>1分100円から</li>
    <li>24時間いつでも</li>
    <li>アプリなら通話料無料</li>
  </ul>
  {url
    ? <a class="btn-cta" href={url} rel="sponsored nofollow noopener" target="_blank">無料クーポンで占い師を探す</a>
    : <span class="btn-cta is-disabled">ご案内の準備中です</span>}
  {url && pixel && <img class="a8px" src={pixel} width="1" height="1" alt="" loading="lazy" />}
  <span class="note">料金や無料の条件は、ココナラ電話占いの公式サイトで最新の情報をご確認ください。</span>
</div>
