---
import { SITE } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/shindan/', label: '相性診断' },
  { href: '/nisshu/', label: '10の日主' },
  { href: '/guide/', label: 'はじめての電話占い' },
  { href: '/articles/', label: 'コラム' },
];
const isCurrent = (href: string) => path.startsWith(href.replace(/\/$/, ''));
---
<div class="pr-bar">当サイトはアフィリエイト広告（PR）を含みます</div>
<header class="site">
  <div class="wrap">
    <a class="logo" href="/" aria-label={`${SITE.name} トップへ`}>
      <svg class="mark" viewBox="0 0 42 42" aria-hidden="true">
        <defs>
          <linearGradient id="logo-gold" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#8E6B2E" /><stop offset=".45" stop-color="#F4E4B6" /><stop offset=".7" stop-color="#B38C45" /><stop offset="1" stop-color="#E9D39C" />
          </linearGradient>
        </defs>
        <circle cx="21" cy="21" r="20.2" fill="none" stroke="url(#logo-gold)" stroke-width=".6" />
        <circle cx="21" cy="21" r="17.4" fill="none" stroke="#C9A55C" stroke-opacity=".45" stroke-width=".4" />
        <text x="21" y="27.6" text-anchor="middle" font-family="Shippori Mincho, serif" font-size="19" font-weight="700" fill="url(#logo-gold)">合</text>
      </svg>
      <span class="words"><small>{SITE.nameSmall}</small><b>{SITE.nameMain}</b></span>
    </a>
    <nav class="main" aria-label="サイト内メニュー">
      {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
  </div>
</header>
