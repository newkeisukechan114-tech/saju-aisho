---
import Base from '../../layouts/Base.astro';
import Corners from '../../components/Corners.astro';
import PRNotice from '../../components/PRNotice.astro';
import AffiliateCTA from '../../components/AffiliateCTA.astro';
import NisshuLinks from '../../components/NisshuLinks.astro';
import { pairSlug, STEM_FULL as SF } from '../../data/pair-data.js';
import { STEM_SLUG as SS } from '../../data/saju-data.js';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import PostCard from '../../components/PostCard.astro';
import { relatedOf, genresOf, GENRE_NAME } from '../../data/genres';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const fmt = (d: Date) => `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
const site = 'https://saju-aisho.com';
const url = `${site}/articles/${entry.slug}/`;
// 記事用のOG画像がまだ無ければ共通画像を使う（tools/make-og.mjs で作成）
const ogImage = fs.existsSync(`public/og/${entry.slug}.jpg`) ? `/og/${entry.slug}.jpg` : '/og/_default.jpg';
// 関連記事：同じ趣味嗜好ジャンル → 同じ日主 → 同じカテゴリ の順でおすすめ
const all = (await getCollection('articles', ({ data }) => !data.draft));
const related = relatedOf(entry, all, 4);
const myGenres = genresOf(entry.slug).filter((g, i, x) => x.indexOf(g) === i).map((g) => GENRE_NAME[g]);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    image: [`${site}${ogImage}`],
    datePublished: entry.data.publishedAt.toISOString(),
    dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
    author: { '@type': 'Organization', name: 'ソウルのサジュ恋愛相性占い 運営者', url: `${site}/about/` },
    publisher: { '@type': 'Organization', name: 'ソウルのサジュ恋愛相性占い', url: site },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: '記事', item: `${site}/articles/` },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
    ],
  },
];
---
<Base title={entry.data.title} description={entry.data.description} ogImage={ogImage} ogType="article" jsonLd={jsonLd}>
  <article class="article">
    <div class="page-head">
      <div class="crumb"><a href="/">トップ</a><span>／</span><a href="/articles/">記事</a><span>／</span>{entry.data.category}</div>
      <div class="article-head">
        <span class="cat">{entry.data.category}</span>
        <h1>{entry.data.title}</h1>
        <p class="dates">
          公開日 <time datetime={entry.data.publishedAt.toISOString()}>{fmt(entry.data.publishedAt)}</time>
          {entry.data.updatedAt && <> ・ 更新日 <time datetime={entry.data.updatedAt.toISOString()}>{fmt(entry.data.updatedAt)}</time></>}
        </p>
      </div>
    </div>
    {entry.data.pr && <PRNotice />}
    <div class="prose frame"><Corners /><Content /></div>
    {entry.data.pr && (entry.data.category === '日主'
      ? <AffiliateCTA heading="自分のサジュを、もっと詳しく知りたいときは" text="日主でわかるのは、生まれ持った基本の気質です。恋愛のタイミングや、気になる人の気持ちなど、具体的なことは占い師に直接聞けます。" />
      : <AffiliateCTA />)}
    {SS.includes(entry.slug) && (() => { const me = SS.indexOf(entry.slug); return (
      <nav class="pair-links reveal">
        <h2 class="cat-title">{SF[me]}とほかの日主の相性</h2>
        <ul>{SF.map((n, x) => <li><a href={`/aisho/${pairSlug(me, x)}/`}>{SF[me]}×{n}</a></li>)}</ul>
        <a class="all" href="/aisho/">55通りの相性一覧へ</a>
      </nav>); })()}
    <NisshuLinks current={entry.slug} />
    {related.length > 0 && (
      <section class="related">
        <h2 class="cat-title reveal">この記事が好きな人におすすめ</h2>
        {myGenres.length > 0 && <p class="related-tags">{myGenres.map((g) => <span>#{g}</span>)}</p>}
        <div class="pcards">{related.map((a) => <PostCard entry={a} />)}</div>
      </section>
    )}
    <div class="next frame reveal"><Corners /><p>あなたとお相手の相性は、生年月日だけで占えます。</p><a class="btn" href="/shindan/">相性を占う</a><a class="sub-link" href="/kojin/">相手がいなくても大丈夫。個人占いで自分のサジュを見る →</a></div>
  </article>
</Base>
