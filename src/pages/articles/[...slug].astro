---
import Base from '../../layouts/Base.astro';
import Corners from '../../components/Corners.astro';
import PRNotice from '../../components/PRNotice.astro';
import AffiliateCTA from '../../components/AffiliateCTA.astro';
import NisshuLinks from '../../components/NisshuLinks.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const fmt = (d: Date) => `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
const site = 'https://saju-aisho.com';
const url = `${site}/articles/${entry.slug}/`;
// 記事用のOG画像がまだ無ければ共通画像を使う（tools/make-og.mjs で作成）
const ogImage = fs.existsSync(`public/og/${entry.slug}.jpg`) ? `/og/${entry.slug}.jpg` : '/og/_default.jpg';
// 関連記事：同じカテゴリ → 新しい順で3本
const others = (await getCollection('articles', ({ data }) => !data.draft))
  .filter((a) => a.slug !== entry.slug)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const related = [
  ...others.filter((a) => a.data.category === entry.data.category),
  ...others.filter((a) => a.data.category !== entry.data.category),
].slice(0, 3);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    image: [`${site}${ogImage}`],
    datePublished: entry.data.publishedAt.toISOString(),
    dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
    author: { '@type': 'Organization', name: 'ソウルのサジュ恋愛相性占い 運営者', url: `${site}/about/` },
    publisher: { '@type': 'Organization', name: 'ソウルのサジュ恋愛相性占い', url: site },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site}/articles/` },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
    ],
  },
];
---
<Base title={entry.data.title} description={entry.data.description} ogImage={ogImage} ogType="article" jsonLd={jsonLd}>
  <article class="article">
    <div class="page-head">
      <div class="crumb"><a href="/">トップ</a><span>／</span><a href="/articles/">コラム</a><span>／</span>{entry.data.category}</div>
      <div class="article-head">
        <span class="cat">{entry.data.category}</span>
        <h1>{entry.data.title}</h1>
        <p class="dates">
          公開日 <time datetime={entry.data.publishedAt.toISOString()}>{fmt(entry.data.publishedAt)}</time>
          {entry.data.updatedAt && <> ・ 更新日 <time datetime={entry.data.updatedAt.toISOString()}>{fmt(entry.data.updatedAt)}</time></>}
        </p>
      </div>
    </div>
    {entry.data.pr && <PRNotice />}
    <div class="prose frame"><Corners /><Content /></div>
    {entry.data.pr && <AffiliateCTA />}
    <NisshuLinks current={entry.slug} />
    {related.length > 0 && (
      <section class="related">
        <h2 class="cat-title reveal">関連記事</h2>
        <div class="posts">
          {related.map((a) => (
            <a class="post frame reveal" href={`/articles/${a.slug}/`}>
              <Corners />
              <span class="cat">{a.data.category}</span>
              <b>{a.data.title}</b>
            </a>
          ))}
        </div>
      </section>
    )}
    <div class="next frame reveal"><Corners /><p>あなたとお相手の相性は、生年月日だけで占えます。</p><a class="btn" href="/shindan/">相性を占う</a></div>
  </article>
</Base>
