---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../data/site';
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const fmt = (d: Date) => `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
---
<Base title="記事一覧｜サジュ・クンハプ・恋愛の相性" description="韓国の四柱推命（サジュ）と相性占い（クンハプ）の基本、日主の解説、恋愛の悩み、電話占いの使い方などの記事一覧です。">
  <div class="page-head">
    <div class="crumb"><a href="/">トップ</a><span>／</span>記事</div>
    <div class="block-head"><span class="en">Articles</span><h1>記事</h1><p>サジュとクンハプの基本から、恋愛の悩み、電話占いの使い方まで。</p></div>
  </div>
  {articles.length === 0 ? (
    <p class="note center">記事は準備中です。</p>
  ) : (
    <>
    <nav class="cat-chips" aria-label="カテゴリ">
      <a class="chip-nayami" href="/nayami/">お悩みから探す →</a>
      <a class="chip-nayami" href="/kaiwai/">界隈から探す →</a>
      {CATEGORIES.filter((c) => articles.some((a) => a.data.category === c)).map((c, i) => (
        <a href={`#cat-${i}`}>{c}<span>{articles.filter((a) => a.data.category === c).length}</span></a>
      ))}
    </nav>
    {CATEGORIES.filter((c) => articles.some((a) => a.data.category === c)).map((c, i) => (
      <section class="cat-group" id={`cat-${i}`}>
        <h2 class="cat-title reveal">{c}</h2>
        <div class="pcards">
          {articles.filter((a) => a.data.category === c).map((a) => <PostCard entry={a} />)}
        </div>
      </section>
    ))}
    </>
  )}
</Base>
