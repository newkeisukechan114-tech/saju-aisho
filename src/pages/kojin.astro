---
import Base from '../layouts/Base.astro';
import Corners from '../components/Corners.astro';
import { SITE } from '../data/site';
import { STEMS, STEM_INFO, STEM_FULL, STEM_SLUG, EL, stemEl } from '../data/saju-data.js';
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: 'https://saju-aisho.com/' },
    { '@type': 'ListItem', position: 2, name: '個人占い', item: 'https://saju-aisho.com/kojin/' },
  ],
}];
---
<Base title="無料サジュ占い（個人）｜生年月日で性格・恋愛傾向・今月の運勢がわかる" description="生年月日を入れるだけで、韓国の四柱推命「サジュ」をひとりで無料で占えます。あなたの日主（イルガン）、五行のバランス、生まれ持った星、相性のいい日主、今月と2027年のキーワードがわかります。" ogImage="/og/_kojin.jpg" jsonLd={jsonLd}>
    <div class="page-head">
      <div class="crumb"><a href="/">トップ</a><span>／</span>個人占い</div>
      <div class="block-head"><span class="en">Saju</span><h1>個人占い｜あなたのサジュを占う</h1><p><b>ひとり用・無料・生年月日だけでOK。</b>生年月日から、あなたのサジュ（四柱）を出して読み解きます。日主（イルガン）、五行のバランス、生まれ持った星、相性のいい日主、今月と2027年のキーワードがわかります。</p></div>
    </div>
    <form class="tool frame" id="form" novalidate>
      <Corners />
      <div class="people solo">
        <div class="person">
          <h3>あなた <small>본인</small></h3>
          <div class="field">
            <span class="flabel" id="k-date-l">生年月日</span>
            <button type="button" class="date-btn" id="k-date-btn" aria-haspopup="dialog" aria-expanded="false" aria-labelledby="k-date-l k-date-btn"><span class="dv">クリックして選ぶ</span><span class="ic" aria-hidden="true"></span></button>
            <input type="hidden" id="k-date">
            <div class="picker frame" id="k-picker" role="dialog" aria-label="生年月日を選ぶ" hidden></div>
          </div>
          <div class="field">
            <span class="flabel" id="k-hour-l">生まれた時間（わからなければそのまま）</span>
            <button type="button" class="date-btn" id="k-hour-btn" aria-haspopup="dialog" aria-expanded="false" aria-labelledby="k-hour-l k-hour-btn"><span class="dv">わからない</span><span class="ic" aria-hidden="true"></span></button>
            <input type="hidden" id="k-hour" value="">
            <div class="picker frame" id="k-hpicker" role="dialog" aria-label="生まれた時間を選ぶ" hidden></div>
          </div>
        </div>
      </div>
      <div class="actions">
        <button class="btn" type="submit" id="run">自分のサジュを占う</button>
        <span class="note">生年月日はこの画面の中だけで計算し、保存も送信もしません。</span>
      </div>
      <div class="err" id="err" role="alert"></div>
    </form>
    <div class="result" id="result" aria-live="polite" data-aff={SITE.affiliate.coconalaUrl} data-px={SITE.affiliate.coconalaPixel}></div>

    <section class="howto">
      <div class="block-head reveal"><span class="en">How it works</span><h2>この占いでわかること</h2><p>サジュ（사주）は「四つの柱」という意味の韓国語で、日本の四柱推命と同じしくみの占いです。生まれた年・月・日・時から8つの文字を出し、その人の気質を読み解きます。</p></div>
      <ol class="steps">
        <li class="frame reveal"><Corners /><span class="num">壹</span><h3>日主（イルガン）</h3><p>生まれた日の天干で、サジュの中心となる文字。あなた自身の性格や恋愛の傾向を表します。日主は10タイプあります。</p></li>
        <li class="frame reveal"><Corners /><span class="num">貳</span><h3>五行のバランス</h3><p>8つの文字を木・火・土・金・水に分けて数えます。多い五行はあなたの持ち味、足りない五行は色や行動で補えます。</p></li>
        <li class="frame reveal"><Corners /><span class="num">參</span><h3>星と運気のキーワード</h3><p>日主から見たほかの文字の関係（十神）で、生まれ持った星がわかります。今月と2027年にめぐる星から、恋愛のキーワードもお伝えします。</p></li>
      </ol>
      <div class="glossary frame reveal"><Corners />
        <h3>10の日主</h3>
        <dl>
          {STEMS.map((s, i) => (<><dt><a href={`/articles/${STEM_SLUG[i]}/`}>{STEM_FULL[i]}（{STEM_INFO[i][0]}）</a></dt><dd>{STEM_INFO[i][1]}</dd></>))}
        </dl>
      </div>
      <div class="limits frame reveal"><Corners />
        <h3>この占いでわからないこと</h3>
        <p>本格的なサジュでは、10年ごとの運気の流れ（大運）や、毎年の運（歳運）まで読み解きます。仕事や恋愛のタイミングなど、より踏み込んだことを知りたいときは、<a href="/guide/">占い師への相談</a>がおすすめです。気になる人がいるなら、<a href="/shindan/">ふたりの相性診断</a>もどうぞ。</p>
      </div>
    </section>
</Base>
<script>
  import '../scripts/kojin.js';
</script>
